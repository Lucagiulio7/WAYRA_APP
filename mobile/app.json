{
  "expo": {
    "name": "Wayra",
    "slug": "viaggio-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "viaggio-ai",
    "newArchEnabled": true,
    "icon": "./public/icon.png",
    "splash": {
      "image": "./public/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f1e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wayra.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.wayra.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./public/adaptive-icon.png",
        "backgroundColor": "#0f0f1e"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single-page-app",
      "favicon": "./public/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication"
    ]
  }
}
