ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ambiente: development | staging | production
ENVIRONMENT=production

# Sentry (opzionale, ma consigliato in produzione)
# Ottieni il DSN da https://sentry.io → Settings → Projects → Client Keys
SENTRY_DSN=

# Database locale (SQLite, per sviluppo)
DATABASE_URL=sqlite:///./viaggio.db

# Database Supabase (PostgreSQL, per produzione)
# Formato: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Sviluppo: lasciare * oppure omettere
# Produzione: lista separata da virgola dei domini autorizzati
# CORS_ORIGINS=https://wayra.app,https://www.wayra.app
CORS_ORIGINS=*
